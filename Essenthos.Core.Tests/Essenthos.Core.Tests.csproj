<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Essenthos.Core.Tests</RootNamespace>
    <AssemblyName>Essenthos.Core.Tests</AssemblyName>
    <IsPackable>false</IsPackable>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>essenthos-core</UserSecretsId>
  
        <!--
            The application sets this, so the tests must. Without it the test project has ICU and
            the application does not, string.Normalize silently does nothing in one and works in
            the other, and a test can pass over code that cannot work.
        -->
        <InvariantGlobalization>true</InvariantGlobalization>
    </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="FluentAssertions" Version="6.12.0" />
    <!-- The main project gets its EF Core from EntityFrameworkCore.Design, which is PrivateAssets=all
         and so does not flow here; without this the tests would compile against the older one Npgsql
         asks for and fail to bind to an assembly built against the newer one. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.12" />
    <!-- The schema tests build the same connection string the app builds, from the same two halves:
         a tracked string and an untracked password. These are the providers that read the second. -->
    <PackageReference Include="Microsoft.Extensions.Configuration.UserSecrets" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.12" />
  </ItemGroup>
  <ItemGroup>
    <!-- One suite over all of them, because a test project per assembly would buy nothing: the
         boundary that matters is that Essenthos.Api does not reference Essenthos.Forge, and that is
         enforced in the API's own project file rather than here. -->
    <ProjectReference Include="..\Essenthos.Corpus\Essenthos.Corpus.csproj" />
    <ProjectReference Include="..\Essenthos.Accounts\Essenthos.Accounts.csproj" />
    <ProjectReference Include="..\Essenthos.Api\Essenthos.Api.csproj" />
    <ProjectReference Include="..\Essenthos.Forge\Essenthos.Forge.csproj" />
    <ProjectReference Include="..\Essenthos.Desk\Essenthos.Desk.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The descriptor fixtures. The real files are the output of a generation pass and stay out
         of the repository like the rest of the corpus; these are written here so the loader can be
         exercised without a gigabyte of it, and so the refusals have something to refuse. -->
    <Content Include="Resources\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
