<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net9.0</TargetFramework>
        <RootNamespace>Essenthos.Core</RootNamespace>
        <AssemblyName>Essenthos.Core</AssemblyName>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <InvariantGlobalization>true</InvariantGlobalization>
        <PublishAot>false</PublishAot>
        <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
        <UserSecretsId>essenthos-core</UserSecretsId>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="EFCore.NamingConventions" Version="9.0.0" />
      <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.3">
        <PrivateAssets>all</PrivateAssets>
        <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      </PackageReference>
      <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="9.0.4" />
      <PackageReference Include="SIL.Machine" Version="3.9.3" />
      <PackageReference Include="SIL.Machine.Translation.Thot" Version="3.9.3" />
    </ItemGroup>

    <ItemGroup>
        <!-- The Nestle tokeniser and the word separator are internal, and each one's off-by-one
             corrupted tens of thousands of words in the corpus, so both are worth a regression test. -->
        <InternalsVisibleTo Include="Essenthos.Core.Tests" />
    </ItemGroup>
    <ItemGroup>
        <!-- The one part of Resources/ small enough to be committed, so it travels with the
             assembly and is read from the output folder rather than through Dataset:ResourcesPath.
             That is why a clean checkout can load the world layer with no fetch step at all. -->
        <Content Include="..\Resources\WorldHistory\**" LinkBase="Resources\WorldHistory" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>
    <ItemGroup>
        <!-- The record of what a second pass found wrong, and the owner's rulings on what it could
             not settle. Inside the assembly rather than beside it: a copy of the corpus that had
             the model's answers and not these would load the readings somebody has already
             established are false, and a file that can go missing is one that eventually does. -->
        <Content Remove="Loading\Encyclopedia\RefusedReadings.json" />
        <Content Remove="Loading\Encyclopedia\OwnRecords.json" />
        <EmbeddedResource Include="Loading\Encyclopedia\RefusedReadings.json" />
        <EmbeddedResource Include="Loading\Encyclopedia\OwnRecords.json" />
    </ItemGroup>

</Project>
