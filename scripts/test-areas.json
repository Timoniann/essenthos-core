{
  "about": "The areas of Essenthos.Core.Tests and which of them a changed file can break. A test class lives in Essenthos.Core.Tests/<Area>/ under namespace Essenthos.Core.Tests.<Area>; a change there runs that area. Every other path takes the first rule whose pattern matches it: \"all\" runs the whole suite, an empty list runs nothing, and a path no rule matches runs the whole suite. Patterns are relative to the repository root; ** crosses folders, * does not. Read by scripts/test-affected.ps1 and checked by Integrity/SuiteAreaTests.",
  "areas": {
    "Witnesses": "Reading and loading the texts: every edition's reader, text sources, repairs, the canonical frame and versification.",
    "Links": "Word links between texts: aligners, compositions, ClearBible, Berean, Strong-tagged links, verse links, name lists.",
    "Evidentia": "EVIDENTIA: its pipeline, language packs, review, ledger and the links it writes.",
    "Lexicon": "Strong's and the other lexicons, stemmers, letters and folding, renderings and their counts.",
    "Names": "Which record a word names: annotations, their carrying across links, name rulings and name forms.",
    "Records": "The encyclopedia: records, own records and rulings, descriptors, relationships, families, events, periods, places.",
    "Reader": "What the API serves the reader: verse, context, search, word, entity and page endpoints.",
    "Platform": "Accounts, the desk, deployment, publication, downloads, Forge verbs and the load's steps.",
    "Integrity": "Verification and corpus checks, schema invariants, provenance and licences of every text."
  },
  "rules": [
    { "path": "Resources/Essenthos/owner-changes.jsonl", "areas": [] },
    { "path": "Resources/**/LICENCE*", "areas": ["Integrity", "Witnesses"] },
    { "path": "**/*.md", "areas": [] },
    { "path": ".gitignore", "areas": [] },
    { "path": ".gitattributes", "areas": [] },
    { "path": "*.DotSettings", "areas": [] },

    { "path": "**/*.csproj", "areas": ["all"] },
    { "path": "Directory.Build.props", "areas": ["all"] },
    { "path": "*.sln", "areas": ["all"] },
    { "path": "compose.yaml", "areas": ["all"] },
    { "path": "initdb/**", "areas": ["all"] },
    { "path": "scripts/test-areas.json", "areas": ["all"] },
    { "path": "scripts/test-affected.ps1", "areas": [] },

    { "path": "Essenthos.Core.Tests/Resources/descriptors/**", "areas": ["Records", "Names"] },
    { "path": "Essenthos.Core.Tests/Resources/relationships/**", "areas": ["Records"] },
    { "path": "Essenthos.Core.Tests/Resources/name-forms/**", "areas": ["Names"] },
    { "path": "Essenthos.Core.Tests/Resources/titles/**", "areas": ["Names"] },
    { "path": "Essenthos.Core.Tests/Resources/evidentia/**", "areas": ["Evidentia"] },
    { "path": "Essenthos.Core.Tests/**", "areas": ["all"] },

    { "path": "Essenthos.Corpus/Database/**", "areas": ["all"] },
