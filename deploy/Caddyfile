# The edge: the reader at /, the API at /v1, on one origin per environment, and the API alone on a
# hostname of its own.
#
#   SITE_IP          2.29.125.205           the reader and its API over plain http, no sign-in
#   SITE_DOMAIN      essenthos.org          the reader, and its API at /v1, with TLS
#   API_DOMAIN       api.essenthos.org      the same API, for the mobile app and anybody else's client
#   DEV_DOMAIN       dev.essenthos.org      dev's reader and API, behind a password
#   DEV_API_DOMAIN   devapi.essenthos.org   dev's API alone, behind the same password
#
# Each group is served only where .env names it: compose passes IP_SITE=on when SITE_IP is set and
# DOMAIN_SITES=on when SITE_DOMAIN is, and an empty switch imports the empty snippet. The bare address
# and the domain can be served together.
#
# The reader uses /v1 on its own origin rather than api.essenthos.org, and that is the point: the
# browser never makes a cross-origin request, CORS has nothing to decide, and the session cookie is
# first-party. The API hostname serves exactly the same process, so nothing is duplicated.

# Quoted, so that with no domain, and so no address set, it is an empty value rather than none.
#
# The default logger is what `docker logs` shows, and an upstream's failure is logged there with the
# request it failed. The same fields go as in the access log, so a reader's whole address or search
# words are not kept there either.
{
	email "{$ACME_EMAIL}"
	log {
		format filter {
			fields {
				request>remote_ip ip_mask 24 48
				request>client_ip ip_mask 24 48
				request>remote_port delete
				request>headers delete
				request>tls delete
				request>uri regexp \?.* ""
			}
		}
	}
}

# The access log, one JSON line per request: when, method, host, path, status, duration and bytes, with
# the address cut to its /24 or /48. The query is dropped, since it can hold what a reader searched for,
# and so are the headers. Caddy rolls a file only by size, so housekeeping.sh is what keeps it under a
# month: it compresses the day's lines each night and removes what is older than ACCESS_LOG_KEEP_DAYS.
(access-log) {
	log {
		output file /var/log/caddy/access.log {
			roll_size 100MiB
			roll_keep 5
		}
		format filter {
			fields {
				request>remote_ip ip_mask 24 48
				request>client_ip ip_mask 24 48
				request>remote_port delete
				request>headers delete
				request>tls delete
				request>uri regexp \?.* ""
				resp_headers delete
				user_id delete
				bytes_read delete
			}
		}
	}
}

# While a corpus is replaced (one copy on the server), every site answers this page with 503: when
# HOST_DATA_ROOT/maintenance/on exists, mounted at /srv/maintenance. It is looked for on each request,
# so creating or removing the file switches it at once, with no reload (deploy/README.md, "The
# updating page"). The API's health stays reachable, so whoever is publishing can see it come back.
&(updating) {
	# A named route keeps only its first directive unless they are wrapped in one route (Caddy 2.10).
	route {
		header {
			Content-Type "text/html; charset=utf-8"
			Cache-Control no-store
			Retry-After 300
		}
		respond <<HTML
		<!doctype html>
		<html lang="uk">
		<head>
		<meta charset="utf-8">
		<meta name="viewport" content="width=device-width, initial-scale=1">
		<meta name="robots" content="noindex">
		<title>Essenthos</title>
		<style>
		body { margin: 0; min-height: 100vh; display: grid; place-items: center; font: 17px/1.5 Georgia, serif; background: #faf8f3; color: #2b2721; }
		main { max-width: 32rem; padding: 2rem 1.5rem; }
		h1 { font-size: 1.6rem; font-weight: normal; margin: 0 0 1.5rem; }
		p { margin: 0 0 1rem; }
		p + p { color: #6b645a; }
		@media (prefers-color-scheme: dark) { body { background: #1d1b18; color: #ece6db; } p + p { color: #a39b8f; } }
		</style>
		</head>
		<body>
		<main>
		<h1>Essenthos</h1>
		<p lang="uk">Оновлюємо сайт. Повернемося за кілька хвилин.</p>
		<p lang="en">We are updating the site. Back in a few minutes.</p>
		<p lang="de">Wir aktualisieren die Website. In wenigen Minuten sind wir zurück.</p>
		<p lang="es">Estamos actualizando el sitio. Volvemos en unos minutos.</p>
		</main>
		</body>
		</html>
		HTML 503
	}
}

(api) {
	# The API is stopped while a corpus release is swapped in and started again after it. Caddy
	# resolves "api" afresh on each connection, and for up to twenty seconds keeps retrying a request
	# whose upstream refuses it, so a publication is a pause rather than an error page.
	#
	# X-Forwarded-For is written here from the connection, and whatever a client sent in it is dropped,
	# since no proxy in front of this one is trusted. The API limits each reader by that address.
	reverse_proxy {args[0]}:8080 {
		lb_try_duration 20s
		lb_try_interval 250ms
	}
}

# The Content-Security-Policy: everything the reader loads, and where from. Scripts come from the site
# alone; styles from the site, the fonts' stylesheet and the inline style elements its dialogs write;
# pictures from the site, from data and blob addresses the family tree and the model viewer draw, and
# from the photo Google or GitHub hands back at sign-in. Nothing is fetched from anywhere but the site,
# no page is framed anywhere, and a form posts only to the site or to a sign-in provider. A browser
# reports each violation to the API, which logs the directive and the blocked address.
(csp-policy) {
	header ?{args[0]} "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https://*.googleusercontent.com https://avatars.githubusercontent.com; connect-src 'self'; frame-src 'none'; object-src 'none'; base-uri 'self'; form-action 'self' https://accounts.google.com https://github.com; frame-ancestors 'none'; report-uri /v1/csp-reports; report-to csp"
	header ?Reporting-Endpoints `csp="/v1/csp-reports"`
}

# The page counter, at /count on the reader's own origin, so a page view is a same-origin request
# the policy's connect-src 'self' already allows and no other origin is ever named. A POST is Umami's
# event, switched by SITE_UMAMI; "off" answers with nothing and counts nothing. Any other method is answered
# with nothing, which also serves a page opened before the old counter's GET was removed. Dev never counts.
#
# POST /count reaches Umami's /api/send and nothing else of it. Umami is told the address only by the
# one header written here from the connection, and it answers the reader with nothing, so the session
# hash it returns goes no further than this proxy. A body over 8 KB is not an event of ours.
(count-event-on) {
	@event method POST
	handle @event {
		request_body {
			max_size 8KB
		}
		rewrite * /api/send
		reverse_proxy umami:3000 {
			header_up X-Real-IP {client_ip}
			header_up -X-Forwarded-For
			header_up -Forwarded
			header_up -True-Client-IP
			header_up -CF-Connecting-IP
			header_up -Cookie
			header_up -Authorization
			header_up -Referer
			header_up -X-Umami-Cache
			@counted status 2xx
			handle_response @counted {
				respond 204
			}
		}
	}
}

(count-event-off) {
	@event method POST
	handle @event {
		respond 204
	}
}

(count-on) {
	handle /count {
		import count-event-{$SITE_UMAMI:off}
		handle {
			respond 204
		}
	}
}

(count-none) {
	handle /count {
		respond 204
	}
}

# One of these per environment, named by SITE_CSP and DEV_CSP. "off" sends only the part of a policy
# that cannot break a page: no framing, no plugins, no other base address. "report-only" sends that,
# and the whole policy for the browser to report against without blocking anything. "enforce" sends
# the whole policy and blocks what breaks it. Any other value stops Caddy at startup.
(csp-off) {
	header ?Content-Security-Policy "frame-ancestors 'none'; object-src 'none'; base-uri 'self'"
}

(csp-report-only) {
	import csp-off
	import csp-policy Content-Security-Policy-Report-Only
}

(csp-enforce) {
	import csp-policy Content-Security-Policy
}

# The reader's pages, as the API writes them for search engines and link previews: each with its own
# title, description, preview and text, inside the same index.html the web container serves. Called
# with the environment's API and web containers.
#
# A page is any GET that is neither under /assets nor a file with an extension; the API has it as
# /v1/pages/<the address>. robots.txt and the sitemaps are the API's too, under /v1. Where the API
# answers a page with a server error or a refusal, or cannot be reached within two seconds, the web
# container serves the plain application instead, so a fault there costs the preview and never the
# page. A page that does not exist is the API's 404, with the application's own not-found page in it,
# and a file the web container does not have, /error.log, is that container's 404 with the same page.
(pages) {
	@crawl path /robots.txt /sitemap.xml /sitemaps/*
	handle @crawl {
		reverse_proxy {args[0]}:8080 {
			rewrite /v1{uri}
			lb_try_duration 2s
			lb_try_interval 250ms
		}
	}

	@page {
		method GET HEAD
		not path /assets/*
		not path_regexp \.[A-Za-z0-9]+$
	}
	handle @page {
		reverse_proxy {args[0]}:8080 {
			rewrite /v1/pages{uri}
			lb_try_duration 2s
			lb_try_interval 250ms
			@unwritten status 5xx 429
			handle_response @unwritten {
				reverse_proxy {args[1]}:8080
			}
		}
	}

	handle {
		reverse_proxy {args[1]}:8080
	}

	handle_errors 502 503 504 {
		@unreached {
			method GET HEAD
			not path /v1/* /assets/*
			not path_regexp \.[A-Za-z0-9]+$
		}
		reverse_proxy @unreached {args[1]}:8080
	}
}

# The texts that may be passed on, as files: what `forge export` wrote and `forge publish` sent, served
# from the folder this is called with (a read-only mount) at /downloads on the same origin as the page
# that lists them, so a link to one is a link to the site. Called with the folder in the proxy
# container.
#
# A file's name carries the first digits of its checksum, so the bytes behind a name never change and a
# browser or a cache may keep a copy for good. The manifest is the one name that does change, and is kept
# for minutes. A text or its attribution is offered as a download under its plain name, and nothing lists a
# folder: a path that is not a file is a 404.
(downloads) {
	@downloads path /downloads/*
	handle @downloads {
		# A route, so the steps run in the order written: Caddy would otherwise run the headers before the
		# prefix is stripped, and their matchers would have to name it.
		route {
			uri strip_prefix /downloads
			root * {args[0]}

			@named path_regexp ^/texts/[^/]+/[^/]+\.[0-9a-f]+\.(jsonl\.gz|txt)$
			header @named Cache-Control "public, max-age=31536000, immutable"

			@manifest path /manifest.json
			header @manifest Cache-Control "public, max-age=300"

			@data path_regexp data ^/texts/([^/]+)/[^/]+\.[0-9a-f]+\.jsonl\.gz$
			header @data Content-Disposition `attachment; filename="{re.data.1}.jsonl.gz"`

			@credit path_regexp credit ^/texts/([^/]+)/ATTRIBUTION\.[0-9a-f]+\.txt$
			header @credit Content-Disposition `attachment; filename="{re.credit.1}-ATTRIBUTION.txt"`

			file_server
		}
	}
}

# The key that lets the site tell Bing, Yandex and the other IndexNow engines which pages changed:
# the file /<key>.txt holding the key, which each of them fetches once to check that whoever sends
# addresses owns the site. INDEXNOW_KEY unset answers nothing but an empty /.txt.
(indexnow) {
	@indexnow path /{$INDEXNOW_KEY}.txt
	handle @indexnow {
		header Content-Type "text/plain; charset=utf-8"
		respond "{$INDEXNOW_KEY}" 200
	}
}

# A hostname that serves only the API is no page to be found by: its robots.txt keeps every crawler
# out, and anything it answers says not to index it.
(unlisted) {
	header X-Robots-Tag "noindex, nofollow"
	handle /robots.txt {
		respond "User-agent: *
Disallow: /
" 200
	}
}

(site) {
	import access-log
	encode zstd gzip

	# No page of the site is meant to be shown inside another site's frame, where a click on it can be
	# steered from outside — the admin area least of all. A policy is only a default: a response that
	# brings its own, as an uploaded photo does, keeps it.
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		-Server
	}
	import csp-{args[0]}

	# The reader is built without source maps, and one that reaches a container anyway is not served.
	@sourcemaps path *.map
	handle @sourcemaps {
		respond 404
	}

	# invoke runs before every handle, whatever its matcher, so nothing gets past the updating page.
	@updating {
		file {
			root /srv/maintenance
			try_files /on
		}
		not path /v1/health/*
	}
	invoke @updating updating
}

# The site on the server's bare address, over plain http, while there is no domain and beside it once
# there is. Not to be indexed: the domain is the site's address. Sign-in is not offered, since the
# providers send a reader back only to a registered https address.
(ip-site-on) {
	http://{$SITE_IP} {
		import site {$SITE_CSP:off}
		import unlisted
		import count-on
		import downloads /srv/downloads
		handle /v1/auth/providers {
			header Content-Type "application/json; charset=utf-8"
			respond `{"providers":[]}` 200
		}
		handle /v1/* {
			import api api
		}
		import pages api web
	}
}

(ip-site-) {
}

import ip-site-{$IP_SITE}

# The site on its domain, with TLS: Caddy asks Let's Encrypt for each name on its first start, which
# needs the DNS records to point here first.
(domain-sites-on) {
	{$SITE_DOMAIN} {
		import site {$SITE_CSP:off}
		import count-on
		import downloads /srv/downloads
		import indexnow
		# The API's answers are data for the reader's script, which a search engine running it still
		# fetches; they are never pages of their own in a search result.
		handle /v1/* {
			header X-Robots-Tag "noindex"
			import api api
		}
		import pages api web
	}

	{$API_DOMAIN} {
		import site off
		import unlisted
		import downloads /srv/downloads
		import api api
	}
}

(domain-sites-) {
}

import domain-sites-{$DOMAIN_SITES}

# The page counts on a hostname of their own, behind Umami's own sign-in, so the owner needs no tunnel.
# Served only where .env names STATS_DOMAIN. Unlike /count this one passes cookies and the whole of Umami:
# it is the sign-in and the dashboard. Its records are never pages of a search result.
(stats-site-on) {
	{$STATS_DOMAIN} {
		import site off
		import unlisted
		handle {
			reverse_proxy umami:3000 {
				header_up X-Real-IP {client_ip}
			}
		}
	}
}

(stats-site-) {
}

import stats-site-{$STATS_SITE}

# Dev is the rehearsal of a publication, not a second public site, so it asks for a password — and
# tells search engines to stay away in case the password is ever shared.
#
# A browser sends its policy reports without the password, so they alone pass without it.
#
# Served only where .env says DEV_SITES=on, beside the compose profile "dev" that runs its containers.
# A production-only machine says neither, serves no dev hostname and asks Let's Encrypt for no
# certificate it could not get.
(dev-sites-on) {
	{$DEV_DOMAIN} {
		import site {$DEV_CSP:report-only}
		header X-Robots-Tag "noindex, nofollow"
		import count-none
		@guarded not path /v1/csp-reports /count
		basic_auth @guarded {
			{$DEV_USER} {$DEV_PASSWORD_HASH}
		}
		import downloads /srv/downloads_dev
		handle /v1/* {
			import api api-dev
		}
		import pages api-dev web-dev
	}

	{$DEV_API_DOMAIN} {
		import site off
		header X-Robots-Tag "noindex, nofollow"
		basic_auth {
			{$DEV_USER} {$DEV_PASSWORD_HASH}
		}
		import downloads /srv/downloads_dev
		import api api-dev
	}
}

(dev-sites-off) {
}

import dev-sites-{$DEV_SITES:off}
