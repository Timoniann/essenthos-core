# Copy to .env beside compose.yaml and fill in. .env is never committed.
# Generate each password with: openssl rand -base64 32 | tr -d '/+='

# Everything the box keeps: the database, releases, backups, certificates. One path, which is the path
# the droplet's daily backup has to cover. Not on an attached volume — see compose.yaml.
HOST_DATA_ROOT=/srv/essenthos

# Backups: how many days each encrypted dump is kept, here and off the droplet. The public key it is
# encrypted to goes in $HOST_DATA_ROOT/backup-key/ (deploy/README.md, "Once: the key").
# BACKUP_KEEP_DAYS=14
# The copy off the droplet, off until both lines are set; the remote is defined in
# $HOST_DATA_ROOT/rclone/rclone.conf (deploy/README.md, "the off-site copy").
# COMPOSE_PROFILES=offsite
# BACKUP_OFFSITE=offsite:<bucket or folder>/essenthos

# Pulled by tag from the registry CI pushes to. Dev may run a newer tag than production.
API_IMAGE=ghcr.io/timoniann/essenthos-api:<commit>
WEB_IMAGE=ghcr.io/timoniann/essenthos-web:<commit>
# API_DEV_IMAGE=
# WEB_DEV_IMAGE=

SITE_DOMAIN=essenthos.org
API_DOMAIN=api.essenthos.org
DEV_DOMAIN=dev.essenthos.org
DEV_API_DOMAIN=devapi.essenthos.org
ACME_EMAIL=

# Each environment's Content-Security-Policy: off, report-only or enforce. report-only blocks nothing and
# has the browser report what the policy would block; the API logs each report. Production stays off
# until dev's reports are clean, and is then switched here, first to report-only and then to enforce.
SITE_CSP=off
DEV_CSP=report-only

# Dev's front door. The hash, not the password, in single quotes because it is full of $ signs that
# compose would otherwise read as variables: docker run --rm caddy:2.10-alpine caddy hash-password
DEV_USER=
DEV_PASSWORD_HASH='<hash>'

POSTGRES_PASSWORD=
READER_PASSWORD=
READER_DEV_PASSWORD=
APP_PASSWORD=
APP_DEV_PASSWORD=

# Sign-in. A provider left empty is not offered, and reading works with neither.
# Google: one OAuth client may list several redirect URIs — https://essenthos.org/v1/auth/google/callback
# and https://dev.essenthos.org/v1/auth/google/callback — so both environments share it.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GitHub: one callback URL per OAuth app, so production and dev each have their own.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_DEV_CLIENT_ID=
GITHUB_DEV_CLIENT_SECRET=

# The site's first admins: verified sign-in addresses, comma-separated. They can make other accounts
# admins in the admin area; these stay admins for as long as they are listed here. The owner is an admin
# whatever this says — the API's own appsettings.json names him — and is listed here as well so the
# file says who is.
ADMIN_EMAILS=timoniann@gmail.com
