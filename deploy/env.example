# Copy to .env beside compose.yaml and fill in. .env is never committed.
# Generate each password with: openssl rand -base64 32 | tr -d '/+='

# Everything the server keeps: the database, releases, pictures, backups, certificates, the updating
# page's switch, and this folder. On the machine's own disk (deploy/README.md, "The machine").
HOST_DATA_ROOT=/srv/essenthos

# Memory: the 4 GB machine's budget (deploy/README.md, "Memory"). Left out, each takes the 8 GB
# machine's value in compose.yaml: 4g, 2GB, 3GB, 32MB, 256MB, 2 workers, 1gb, API 1g, counter 256m.
DB_MEM_LIMIT=2g
DB_SHARED_BUFFERS=768MB
DB_EFFECTIVE_CACHE_SIZE=1536MB
DB_WORK_MEM=16MB
DB_MAINTENANCE_WORK_MEM=256MB
DB_PARALLEL_WORKERS=1
DB_SHM_SIZE=512mb
API_MEM_LIMIT=768m
# The API's statement timeout in seconds: 5 by default, 20 on the 4 GB budget, where a cold chapter of two
# texts takes about 8 s (PRB-1375).
API_STATEMENT_TIMEOUT_SECONDS=20
WEB_MEM_LIMIT=128m
ANALYTICS_MEM_LIMIT=128m

# Backups: how many days each encrypted dump is kept, here and off the machine. The public key it is
# encrypted to goes in $HOST_DATA_ROOT/backup-key/ (deploy/README.md, "Once: the key").
# BACKUP_KEEP_DAYS=14
# Without that key every run fails and writes nothing. Plain dumps only if this says so on purpose:
# BACKUP_ALLOW_UNENCRYPTED=yes
# The backup container turns unhealthy when a database's last good dump is older than this:
# BACKUP_STALE_HOURS=26
# The copy off the machine, off until both lines are set; the remote is defined in
# $HOST_DATA_ROOT/rclone/rclone.conf (deploy/README.md, "the off-site copy").
# COMPOSE_PROFILES=offsite
# BACKUP_OFFSITE=offsite:<bucket or folder>/essenthos

# The page counter, off until all three are set (deploy/README.md, "Page counts"). COMPOSE_PROFILES is
# one comma-separated list: with the off-site copy as well it is offsite,analytics. STATS_PASSWORD is
# read when the database is first created; on an older one, create the role by hand as the README says.
# The reader's image must also be built with VITE_ANALYTICS_ENDPOINT=/count to send anything.
# COMPOSE_PROFILES=analytics
# SITE_ANALYTICS=on
# STATS_PASSWORD=
# Where the counter's dashboard listens on the machine's loopback, for the ssh tunnel.
# ANALYTICS_HOST_PORT=8081
# The counts on their own hostname, behind the counter's sign-in; its DNS record must point here first.
# STATS_DOMAIN=stats.essenthos.org

# Images already on this machine, sent by scripts/send-images.ps1 from the workstation and named by
# full commit hash; scripts/deploy.ps1 writes these lines. Nothing is pulled from a registry.
API_IMAGE=essenthos-api:<commit>
WEB_IMAGE=essenthos-web:<commit>

# Where the site answers (deploy/README.md, "Addresses"). The server's bare address, over plain http
# with no sign-in; empty serves nothing there.
SITE_IP=2.29.125.205
# The domain, with TLS, once its DNS records point at this machine; until then all three stay empty.
# Set together: the reader's domain, the API's hostname, and the address Let's Encrypt writes to.
SITE_DOMAIN=
API_DOMAIN=
ACME_EMAIL=

# Each environment's Content-Security-Policy: off, report-only or enforce. report-only blocks nothing and
# has the browser report what the policy would block; the API logs each report. Production stays off
# until dev's reports are clean, and is then switched here, first to report-only and then to enforce.
SITE_CSP=off

# The IndexNow key, which tells Bing, Yandex and the other IndexNow engines that a list of changed pages
# comes from the site's owner: 8 to 128 letters, digits or dashes, made once (openssl rand -hex 16) and
# never secret, since the site serves it at /<key>.txt. Empty serves nothing (deploy/README.md,
# "Search engines").
INDEXNOW_KEY=

POSTGRES_PASSWORD=
READER_PASSWORD=
APP_PASSWORD=

# Sign-in, on the domain only: a provider left empty is not offered, and reading works with neither.
# The bare address never offers it.
# Google: one OAuth client may list several redirect URIs — https://essenthos.org/v1/auth/google/callback
# and https://dev.essenthos.org/v1/auth/google/callback — so both environments share it.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GitHub: one callback URL per OAuth app, so production and dev each have their own.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# The site's first admins: verified sign-in addresses, comma-separated. They can make other accounts
# admins in the admin area; these stay admins for as long as they are listed here. The owner is an admin
# whatever this says — the API's own appsettings.json names him — and is listed here as well so the
# file says who is.
ADMIN_EMAILS=timoniann@gmail.com

# Dev, only on a machine that runs it — never on the production server (TSK-1002). Every line below
# together: the containers (the profile; with other profiles, one comma-separated list such as
# dev,offsite), its two hostnames, its front door and its own database roles, which initdb creates only
# when both passwords are set. Dev may run a newer tag than production.
# COMPOSE_PROFILES=dev
# DEV_SITES=on
# DEV_DOMAIN=dev.essenthos.org
# DEV_API_DOMAIN=devapi.essenthos.org
# DEV_CSP=report-only
# The hash, not the password, in single quotes because it is full of $ signs that compose would
# otherwise read as variables: docker run --rm caddy:2.10-alpine caddy hash-password
# DEV_USER=
# DEV_PASSWORD_HASH='<hash>'
# READER_DEV_PASSWORD=
# APP_DEV_PASSWORD=
# GITHUB_DEV_CLIENT_ID=
# GITHUB_DEV_CLIENT_SECRET=
# API_DEV_IMAGE=
# WEB_DEV_IMAGE=
