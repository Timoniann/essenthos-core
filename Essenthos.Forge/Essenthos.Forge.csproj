<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <RootNamespace>Essenthos.Core</RootNamespace>
        <AssemblyName>Essenthos.Forge</AssemblyName>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <InvariantGlobalization>true</InvariantGlobalization>
        <UserSecretsId>essenthos-core</UserSecretsId>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\Essenthos.Corpus\Essenthos.Corpus.csproj" />
    </ItemGroup>

    <ItemGroup>
        <!-- The web SDK copies this; the console SDK does not. -->
        <Content Include="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.12" />
        <PackageReference Include="SIL.Machine" Version="3.9.3" />
        <PackageReference Include="SIL.Machine.Translation.Thot" Version="3.9.3" />
    </ItemGroup>

    <ItemGroup>
        <!-- The Nestle tokeniser and the word separator are internal, and each one's off-by-one
             corrupted tens of thousands of words in the corpus, so both are worth a regression test. -->
        <InternalsVisibleTo Include="Essenthos.Core.Tests" />
    </ItemGroup>

    <ItemGroup>
        <!-- The one part of Resources/ small enough to be committed, so it travels with the
             assembly and is read from the output folder rather than through Dataset:ResourcesPath.
             That is why a clean checkout can load the world layer with no fetch step at all. -->
        <Content Include="..\Resources\WorldHistory\**" LinkBase="Resources\WorldHistory" CopyToOutputDirectory="PreserveNewest" />

        <!-- The commandments as this project curated them from two public-domain works, committed
             for the same reason and read the same way. -->
        <Content Include="..\Resources\Maimonides\commandments.tsv" Link="Resources\Maimonides\commandments.tsv" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

    <ItemGroup>
        <!-- The record of what a second pass found wrong, what it named instead, which answers a
             later run replaced, and the owner's rulings on what none of them could settle. Inside
             the assembly rather than beside it: a copy of the corpus that had the model's answers
             and not these would load the readings somebody has already established are false and
             the answers a later run superseded, and a file that can go missing is one that
             eventually does. -->
        <Content Remove="Loading\Encyclopedia\RefusedReadings.json" />
        <Content Remove="Loading\Encyclopedia\SupersededReadings.json" />
        <Content Remove="Loading\Encyclopedia\OwnRecords.json" />
        <Content Remove="Loading\Encyclopedia\ReviewRecords.json" />
        <Content Remove="Loading\Encyclopedia\Peoples.json" />
        <EmbeddedResource Include="Loading\Encyclopedia\RefusedReadings.json" />
        <EmbeddedResource Include="Loading\Encyclopedia\SupersededReadings.json" />
        <EmbeddedResource Include="Loading\Encyclopedia\OwnRecords.json" />
        <EmbeddedResource Include="Loading\Encyclopedia\Distinguishers.json" />
        <EmbeddedResource Include="Loading\Encyclopedia\ReviewRecords.json" />
        <EmbeddedResource Include="Loading\Encyclopedia\ReportRecords.json" />
        <Content Remove="Loading\Encyclopedia\OwnNames.json" />
        <EmbeddedResource Include="Loading\Encyclopedia\OwnNames.json" />
        <Content Remove="Loading\Encyclopedia\WithdrawnRecords.json" />
        <EmbeddedResource Include="Loading\Encyclopedia\WithdrawnRecords.json" />
        <Content Remove="Loading\Encyclopedia\TitleRecords.json" />
        <EmbeddedResource Include="Loading\Encyclopedia\TitleRecords.json" />
        <Content Remove="Loading\Encyclopedia\TitleReadings.json" />
        <EmbeddedResource Include="Loading\Encyclopedia\TitleReadings.json" />
        <Content Remove="Loading\Encyclopedia\UnsettledRecords.json" />
        <EmbeddedResource Include="Loading\Encyclopedia\UnsettledRecords.json" />
        <Content Remove="Loading\Encyclopedia\UnsettledRecordsSecond.json" />
        <EmbeddedResource Include="Loading\Encyclopedia\UnsettledRecordsSecond.json" />
        <EmbeddedResource Include="Loading\Encyclopedia\GenealogyRecords.json" />
        <EmbeddedResource Include="Loading\Encyclopedia\SeveralPeopleRecords.json" />
        <EmbeddedResource Include="Loading\Encyclopedia\SeveralPeopleRecordsSecond.json" />
        <EmbeddedResource Include="Loading\Encyclopedia\SeveralPeopleRecordsThird.json" />
        <EmbeddedResource Include="Loading\Encyclopedia\SeveralPeopleRecordsFourth.json" />
        <EmbeddedResource Include="Loading\Encyclopedia\AddressedRecords.json" />
        <EmbeddedResource Include="Loading\Encyclopedia\NamesakeRecords.json" />
        <Content Remove="Loading\Encyclopedia\ObjectRecords.json" />
        <EmbeddedResource Include="Loading\Encyclopedia\ObjectRecords.json" />
        <Content Remove="Loading\Encyclopedia\ObservanceRecords.json" />
        <EmbeddedResource Include="Loading\Encyclopedia\ObservanceRecords.json" />
        <Content Remove="Loading\Encyclopedia\NarrativeRecords.json" />
        <EmbeddedResource Include="Loading\Encyclopedia\NarrativeRecords.json" />
        <Content Remove="Loading\Encyclopedia\DuplicateRecords.json" />
        <EmbeddedResource Include="Loading\Encyclopedia\DuplicateRecords.json" />
        <Content Remove="Loading\Encyclopedia\UssherDatings.json" />
        <EmbeddedResource Include="Loading\Encyclopedia\UssherDatings.json" />
        <Content Remove="Loading\Encyclopedia\ReignRecords.json" />
        <EmbeddedResource Include="Loading\Encyclopedia\ReignRecords.json" />
        <Content Remove="Loading\Encyclopedia\ReignRulings.json" />
        <EmbeddedResource Include="Loading\Encyclopedia\ReignRulings.json" />

        <!-- The peoples this corpus names, and the two things about them nothing else can supply:
             what to call the nine gentilics whose entry yields no usable English word, and the
             tribes of Israel, which no lexicon names because Hebrew names a tribe with the
             ancestor's own word. -->
        <EmbeddedResource Include="Loading\Encyclopedia\Peoples.json" />

        <!-- The public works chosen to picture people and places, each with its author, licence and
             source page. The pictures themselves are under Resources/Images, outside git. -->
        <Content Remove="Loading\Encyclopedia\PublicImages.json" />
        <EmbeddedResource Include="Loading\Encyclopedia\PublicImages.json" />

        <!-- Where the face is in each picture of a person, which scripts/find-faces.ps1 measures and
             the loader turns into the head and shoulders a small rendering shows. -->
        <Content Remove="Loading\Encyclopedia\PortraitFaces.json" />
        <EmbeddedResource Include="Loading\Encyclopedia\PortraitFaces.json" />

        <!-- The corrections scripts/swete-corrections.py writes out, one per token, for the reader and
             the warm pass to make alike. -->
        <Content Remove="Swete\SweteCorrections.json" />
        <EmbeddedResource Include="Swete\SweteCorrections.json" />
        <Content Remove="Swete\SwetePage.json" />
        <EmbeddedResource Include="Swete\SwetePage.json" />

        <!-- What each text was translated from, revised from or shares a tradition with, kept by hand. -->
        <Content Remove="Loading\TextRelations.json" />
        <EmbeddedResource Include="Loading\TextRelations.json" />

        <!-- The same for bible4u's Synodal, which scripts/synodal-corrections.py writes out. -->
        <Content Remove="Loading\SynodalCorrections.json" />
        <EmbeddedResource Include="Loading\SynodalCorrections.json" />

        <!-- The verses Brenton's Greek file begins at another word than his English, reviewed one by one. -->
        <Content Remove="Loading\BrentonDivisions.json" />
        <EmbeddedResource Include="Loading\BrentonDivisions.json" />

        <!-- Which Greek verse each verse of the Ge'ez books the church divides its own way answers. -->
        <EmbeddedResource Include="BetaMasaheft\GeezVerseMap.tsv" />
    </ItemGroup>

    <!-- An EVIDENTIA run records the build that made it, and a version number that never changes
         names no build. The commit goes into the informational version, marked dirty when the tree
         had uncommitted changes; a build with no git, such as the container's, keeps the plain
         version rather than failing. -->
    <Target Name="StampSourceRevision" BeforeTargets="PrepareForBuild" Condition="'$(SourceRevisionId)' == ''">
        <Exec Command="git rev-parse --short=12 HEAD" ConsoleToMSBuild="true" IgnoreExitCode="true" StandardOutputImportance="low" StandardErrorImportance="low" ContinueOnError="true">
            <Output TaskParameter="ConsoleOutput" PropertyName="StampedRevision" />
            <Output TaskParameter="ExitCode" PropertyName="StampedRevisionExit" />
        </Exec>
        <Exec Command="git status --porcelain --untracked-files=no" ConsoleToMSBuild="true" IgnoreExitCode="true" StandardOutputImportance="low" StandardErrorImportance="low" ContinueOnError="true" Condition="'$(StampedRevisionExit)' == '0'">
            <Output TaskParameter="ConsoleOutput" PropertyName="StampedChanges" />
        </Exec>
        <PropertyGroup Condition="'$(StampedRevisionExit)' == '0'">
            <SourceRevisionId>$(StampedRevision)</SourceRevisionId>
            <SourceRevisionId Condition="'$(StampedChanges)' != ''">$(StampedRevision)-dirty</SourceRevisionId>
        </PropertyGroup>
    </Target>

    <ItemGroup>
        <!-- The web SDK supplies these as implicit global usings and the plain one does not, so
             they are declared rather than added to several hundred files. -->
        <Using Include="Microsoft.Extensions.Configuration" />
        <Using Include="Microsoft.Extensions.DependencyInjection" />
        <Using Include="Microsoft.Extensions.Hosting" />
        <Using Include="Microsoft.Extensions.Logging" />
    </ItemGroup>

</Project>