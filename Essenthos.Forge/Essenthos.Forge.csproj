<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <RootNamespace>Essenthos.Core</RootNamespace>
        <AssemblyName>Essenthos.Forge</AssemblyName>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <InvariantGlobalization>true</InvariantGlobalization>
        <UserSecretsId>essenthos-core</UserSecretsId>
        <!-- The producers run a dozen pairs at once, and one workstation heap stops all of them for each collection. -->
        <ServerGarbageCollection>true</ServerGarbageCollection>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\Essenthos.Corpus\Essenthos.Corpus.csproj" />
        <ProjectReference Include="..\Essenthos.Products\Essenthos.Products.csproj" />
        <ProjectReference Include="..\Essenthos.Products.Postgres\Essenthos.Products.Postgres.csproj" />
        <!-- The documents record and Strong pages are written from are composed at build by the same page code the
             API serves them with (TSK-1670), so a stored page is the page the API would compose. -->
        <ProjectReference Include="..\Essenthos.Answers\Essenthos.Answers.csproj" />
    </ItemGroup>

    <ItemGroup>
        <!-- The web SDK copies this; the console SDK does not. -->
        <Content Include="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
        <Content Include="Records\OwnerRows\*.tsv" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.12" />
        <!-- Wade Maxfield's ASV Strong numbers ship only as a SQLite file (ASV.bbl, TSK-1890). Microsoft's provider
             (MIT; SQLite itself is public domain, the e_sqlite3 bundle Apache 2.0) reads it; writing a reader of
             SQLite's page format instead would be a B-tree, record and overflow parser of our own to keep. -->
        <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
        <PackageReference Include="SIL.Machine" Version="3.9.3" />
        <PackageReference Include="SIL.Machine.Translation.Thot" Version="3.9.3" />
    </ItemGroup>

    <ItemGroup>
        <!-- The Nestle tokeniser and the word separator are internal, and each one's off-by-one
             corrupted tens of thousands of words in the corpus, so both are worth a regression test. -->
        <InternalsVisibleTo Include="Essenthos.Core.Tests" />
    </ItemGroup>

    <ItemGroup>
        <!-- The commandments as this project curated them from two public-domain works, committed
             for the same reason and read the same way. -->
        <Content Include="..\Resources\Maimonides\commandments.tsv" Link="Resources\Maimonides\commandments.tsv" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

    <ItemGroup>
        <!-- The lists the Forge still carries embedded: what a person is known for, the clauses held back, the records
             the owner holds apart, the things and observances the owner's console edits, the coordinates read
             from other sources and the folds declined. -->
        <EmbeddedResource Include="Loading\Encyclopedia\KnownFor.json" />
        <Content Remove="Loading\Encyclopedia\WithheldClauses.json" />
        <EmbeddedResource Include="Loading\Encyclopedia\WithheldClauses.json" />
        <EmbeddedResource Include="Loading\Encyclopedia\HeldApartRecords.json" />
        <Content Remove="Loading\Encyclopedia\ObjectRecords.json" />
        <EmbeddedResource Include="Loading\Encyclopedia\ObjectRecords.json" />
        <EmbeddedResource Include="Loading\Encyclopedia\LocationSupplements.json" />
        <Content Remove="Loading\Encyclopedia\ObservanceRecords.json" />
        <EmbeddedResource Include="Loading\Encyclopedia\ObservanceRecords.json" />
        <Content Remove="Loading\Encyclopedia\NarrativeRecords.json" />
        <EmbeddedResource Include="Loading\Encyclopedia\NarrativeRecords.json" />
        <Content Remove="Loading\Encyclopedia\DuplicateRecords.json" />
        <EmbeddedResource Include="Loading\Encyclopedia\DuplicateRecords.json" />

        <!-- The public works chosen to picture people and places, each with its author, licence and
             source page. The pictures themselves are under Resources/Images, outside git. -->
        <Content Remove="Loading\Encyclopedia\PublicImages.json" />
        <EmbeddedResource Include="Loading\Encyclopedia\PublicImages.json" />

        <!-- Where the face is in each picture of a person, which scripts/find-faces.ps1 measures and
             the loader turns into the head and shoulders a small rendering shows. -->
        <Content Remove="Loading\Encyclopedia\PortraitFaces.json" />
        <EmbeddedResource Include="Loading\Encyclopedia\PortraitFaces.json" />

        <!-- What each text was translated from, revised from or shares a tradition with, kept by hand. -->
        <Content Remove="Loading\TextRelations.json" />
        <EmbeddedResource Include="Loading\TextRelations.json" />

        <!-- What two readers made of each placement the answer key and EVIDENTIA disagree on. Read by
             the scorer of a measurement and by nothing else: it is never a link and never a training label. -->
        <EmbeddedResource Include="Loading\Links\Evidentia\EvidentiaKeyCorrections.json" />

        <!-- The combiner's fitted weights and calibration, versioned with the code that computes its features. -->
        <EmbeddedResource Include="Loading\Links\Evidentia\EvidentiaCombiner.json" />

        <!-- Which Greek verse each verse of the Ge'ez books the church divides its own way answers, kept beside
             geez.tsv so the products it shapes can name it among their inputs. -->
        <EmbeddedResource Include="..\Resources\Essenthos\versification\geez-verse-map.tsv"
                          LogicalName="Essenthos.Core.BetaMasaheft.GeezVerseMap.tsv" />

        <!-- Which Greek verse each Ge'ez verse answers where the edition numbers otherwise than the
             Greek, kept with the project's other reviewable decisions and built in from there. -->
        <EmbeddedResource Include="..\Resources\Essenthos\versification\geez.tsv"
                          LogicalName="Essenthos.Core.BetaMasaheft.GeezVersification.tsv" />
    </ItemGroup>

    <!-- An EVIDENTIA run records the build that made it, and a version number that never changes
         names no build. The commit goes into the informational version, marked dirty when the tree
         had uncommitted changes to the code; a build with no git, such as the container's, keeps
         the plain version rather than failing. Resources/ is left out of the test: the owner's
         working files there are never committed, and a release names the resources by their own
         manifest hash. -->
    <Target Name="StampSourceRevision" BeforeTargets="PrepareForBuild" Condition="'$(SourceRevisionId)' == ''">
        <Exec Command="git rev-parse --short=12 HEAD" ConsoleToMSBuild="true" IgnoreExitCode="true" StandardOutputImportance="low" StandardErrorImportance="low" ContinueOnError="true">
            <Output TaskParameter="ConsoleOutput" PropertyName="StampedRevision" />
            <Output TaskParameter="ExitCode" PropertyName="StampedRevisionExit" />
        </Exec>
        <Exec Command="git status --porcelain --untracked-files=no -- &quot;:/&quot; &quot;:(top,exclude)Resources&quot;" ConsoleToMSBuild="true" IgnoreExitCode="true" StandardOutputImportance="low" StandardErrorImportance="low" ContinueOnError="true" Condition="'$(StampedRevisionExit)' == '0'">
            <Output TaskParameter="ConsoleOutput" PropertyName="StampedChanges" />
        </Exec>
        <PropertyGroup Condition="'$(StampedRevisionExit)' == '0'">
            <SourceRevisionId>$(StampedRevision)</SourceRevisionId>
            <SourceRevisionId Condition="'$(StampedChanges)' != ''">$(StampedRevision)-dirty</SourceRevisionId>
        </PropertyGroup>
    </Target>

    <ItemGroup>
        <!-- The web SDK supplies these as implicit global usings and the plain one does not, so
             they are declared rather than added to several hundred files. -->
        <Using Include="Microsoft.Extensions.Configuration" />
        <Using Include="Microsoft.Extensions.DependencyInjection" />
        <Using Include="Microsoft.Extensions.Hosting" />
        <Using Include="Microsoft.Extensions.Logging" />
    </ItemGroup>

    <ItemGroup>
        <!-- Descriptors, family trees and record lines, composed in Essenthos.Corpus so the build can make them too (TSK-1666). -->
        <Using Include="Essenthos.Core.Descriptions" />
        <Using Include="Essenthos.Core.Context" />
    </ItemGroup>

    <!-- The code of each load the build fills tables with, digested per load into LoadCode.All (PRB-1867): an apply loads
         again whole the tables of a load whose code moved since the database was served, as it does for a moved product.
         Tables names what the load fills, which ApplyReloads maps to the load again or refuses (@carried: every carried
         table). A file a load's rows depend on belongs in its list. -->
    <ItemGroup>
        <LoadCode Include="Records\RecordFiles*.cs;Records\RecordCanons.cs;..\Essenthos.Answers\Endpoints\StoredEventOrder.cs" Load="records" Tables="entity entity_canon" />
        <LoadCode Include="Names\NamesLoad.cs" Load="names" Tables="word_entity" />
        <LoadCode Include="Indexes\IndexLoad.cs" Load="indexes" Tables="strong_rendering strong_book text_form word_rendering word_rendering_witness entity_rendering" />
        <LoadCode Include="Indexes\StrongNumberFiles.cs" Load="numbers" Tables="word_rendered_strong" />
        <LoadCode Include="Indexes\StoredStrongFiles.cs" Load="stored-strong" Tables="strong_occurrence text_pair_links" />
        <LoadCode Include="Loading\CanonicalFrameLoader.cs" Load="frames" Tables="verse_reference" />
        <LoadCode Include="Mapping\VerseLinkFiles.cs" Load="verse-links" Tables="verse_link verse_link_verse" />
        <LoadCode Include="Build\CarriedTables.cs" Load="carried" Tables="@carried" />
        <LoadCode Include="Build\TextLoad.cs" Load="texts" Tables="word" />
        <LoadCode Include="Mapping\MappingLoad.cs" Load="links" Tables="link" />
    </ItemGroup>

    <!-- A digest of the source, line endings made one, so a Debug and a Release Forge and any checkout agree. -->
    <UsingTask TaskName="DigestLoadCode" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
        <ParameterGroup>
            <Sources ParameterType="Microsoft.Build.Framework.ITaskItem[]" Required="true" />
            <OutputFile ParameterType="System.String" Required="true" />
        </ParameterGroup>
        <Task>
            <Using Namespace="System.IO" />
            <Using Namespace="System.Linq" />
            <Using Namespace="System.Security.Cryptography" />
            <Using Namespace="System.Text" />
            <Code Type="Fragment" Language="cs"><![CDATA[
            var code = new StringBuilder();
            code.Append("// Made by the DigestLoadCode target of Essenthos.Forge.csproj from the files each load is declared with.\n");
            code.Append("namespace Essenthos.Core.Build;\n\ninternal static partial class LoadCode\n{\n    public static readonly LoadCodeDigest[] All =\n    [\n");
            foreach (var load in Sources.GroupBy(s => s.GetMetadata("Load")).OrderBy(g => g.Key, StringComparer.Ordinal))
            {
                var text = new StringBuilder();
                foreach (var source in load.OrderBy(s => s.ItemSpec.Replace('\\', '/'), StringComparer.Ordinal))
                {
                    text.Append(source.ItemSpec.Replace('\\', '/')).Append('\n')
                        .Append(File.ReadAllText(source.GetMetadata("FullPath")).Replace("\r\n", "\n")).Append('\n');
                }

                string digest;
                using (var sha = SHA256.Create())
                {
                    digest = string.Concat(sha.ComputeHash(Encoding.UTF8.GetBytes(text.ToString())).Take(8).Select(b => b.ToString("x2")));
                }
                var tables = load.Select(s => s.GetMetadata("Tables")).First(t => t.Length > 0)
                    .Split(new[] { ' ' }, StringSplitOptions.RemoveEmptyEntries).Select(t => "\"" + t + "\"");
                code.Append("        new(\"").Append(load.Key).Append("\", \"").Append(digest).Append("\", [").Append(string.Join(", ", tables)).Append("]),\n");
            }

            code.Append("    ];\n}\n");
            var written = code.ToString();
            if (!File.Exists(OutputFile) || File.ReadAllText(OutputFile) != written)
            {
                Directory.CreateDirectory(Path.GetDirectoryName(OutputFile));
                File.WriteAllText(OutputFile, written);
            }
            ]]></Code>
        </Task>
    </UsingTask>

    <Target Name="DigestLoadCode" BeforeTargets="CoreCompile">
        <DigestLoadCode Sources="@(LoadCode)" OutputFile="$(IntermediateOutputPath)LoadCode.g.cs" />
        <ItemGroup>
            <Compile Include="$(IntermediateOutputPath)LoadCode.g.cs" />
            <FileWrites Include="$(IntermediateOutputPath)LoadCode.g.cs" />
        </ItemGroup>
    </Target>

</Project>
