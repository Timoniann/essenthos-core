{
  "Database:ConnectionString": "Host=localhost;Port=5437;Database=essenthos_core;Username=essenthos",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "Publish": {
    "Targets": {
      "dev": {
        "DataRoot": "/srv/essenthos",
        "Container": "essenthos-db-1",
        "Database": "corpus_dev",
        "Reader": "essenthos_reader_dev",
        "DatabasePort": 5432,
        "ApiContainer": "essenthos-api-dev-1"
      },
      "prod": {
        "DataRoot": "/srv/essenthos",
        "Container": "essenthos-db-1",
        "Database": "corpus",
        "Reader": "essenthos_reader",
        "DatabasePort": 5432,
        "ApiContainer": "essenthos-api-1",
        "After": "dev"
      },
      "rehearsal-dev": {
        "Local": true,
        "DataRoot": ".rehearsal",
        "EnvFile": "deploy/.env.rehearsal",
        "Container": "essenthos-rehearsal-db-1",
        "Database": "corpus_dev",
        "Reader": "essenthos_reader_dev",
        "DatabasePort": 5438,
        "ApiContainer": "essenthos-rehearsal-api-dev-1"
      },
      "rehearsal": {
        "Local": true,
        "DataRoot": ".rehearsal",
        "EnvFile": "deploy/.env.rehearsal",
        "Container": "essenthos-rehearsal-db-1",
        "Database": "corpus",
        "Reader": "essenthos_reader",
        "DatabasePort": 5438,
        "ApiContainer": "essenthos-rehearsal-api-1",
        "After": "rehearsal-dev"
      }
    }
  }
}
